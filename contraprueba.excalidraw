   "text": "6. CUÁNDO SE USA (ciclo de 6 semanas)",
   "originalText": "6. CUÁNDO SE USA (ciclo de 6 semanas)",
   "fontSize": 24,
   "fontFamily": 2,
   "textAlign": "left",
