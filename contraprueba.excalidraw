  {
   "id": "eljooa5lqsa",
   "type": "text",
   "x": 22,
   "y": 802.25,
   "width": 733.8100000000001,
   "height": 340.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
