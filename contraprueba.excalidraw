  {
   "id": "e052loi03p8",
   "type": "text",
   "x": 3582,
   "y": 411.25,
   "width": 688.76,
   "height": 340.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
