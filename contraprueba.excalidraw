   "text": "4. BASE PERÚ: QUÉ PLANTEA 1.º DE SECUNDARIA",
   "originalText": "4. BASE PERÚ: QUÉ PLANTEA 1.º DE SECUNDARIA",
   "fontSize": 24,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
