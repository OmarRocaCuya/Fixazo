   "text": "10. MÉTRICAS Y RÚBRICA",
   "originalText": "10. MÉTRICAS Y RÚBRICA",
   "fontSize": 24,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
