  {
   "id": "eu33xtplpft",
   "type": "text",
   "x": 22,
   "y": 204.0,
   "width": 2571.85,
   "height": 71.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
