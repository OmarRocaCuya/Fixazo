   "text": "6. EVALUACIÓN Y RÚBRICA",
   "originalText": "6. EVALUACIÓN Y RÚBRICA",
   "fontSize": 24,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
