# Port the HTTP server listens on.
PORT=8787
# Optional. Without it the service runs the deterministic (no-AI) fallback.
OPENROUTER_API_KEY=
# Optional model override (default: anthropic/claude-haiku-5.5).
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Comma-separated list of allowed CORS origins. Empty = same-origin only; "*" = any.
ALLOWED_ORIGINS=http://localhost:3000
# Optional. When set, /v1/enrich requires "Authorization: Bearer <token>".
SERVICE_TOKEN=
# Max cached responses (in-memory LRU).
CACHE_SIZE=200
