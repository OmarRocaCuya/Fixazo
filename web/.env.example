# Opcional. Vacío = misiones y evaluación por reglas, sin LLM.
# Para probar IA, copia este archivo a .env.local y añade la clave solo allí.
# En el hosting usa su almacén de secretos; no subas .env.local al repositorio.
# Nunca uses el prefijo NEXT_PUBLIC_ para esta clave.
ANTHROPIC_API_KEY=

# Juez del periódico: Claude Haiku 5.5 vía OpenRouter, solo demo adulta/sintética.
# Activación explícita; usa también VOICE_ACCESS_CODE y consentimiento por sesión.
# No aceptar voces de menores ni datos personales. Clave solo en secretos servidor.
# Se exige enrutamiento con no recopilación y ZDR; sin proveedor elegible no evalúa.
PERIODICO_JUDGE_ENABLED=false
OPENROUTER_API_KEY=

# Servicios de voz externos DESACTIVADOS por defecto.
# adult-demo = solo voces adultas/sintéticas; approved-pilot exige revisión real.
VOICE_CLOUD_MODE=disabled
# Generar un secreto aleatorio >=16 caracteres. Nunca poner NEXT_PUBLIC_.
VOICE_ACCESS_CODE=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
# Sólo tras aprobación documentada; estas banderas no sustituyen contratos.
CHILD_VOICE_PRIVACY_APPROVED=false
OPENAI_ZDR_CONFIRMED=false

# Meta autoalojado: servidor de inferencia APARTE de Vercel.
# URL HTTPS del servicio, sin credenciales ni parámetros. Token sólo de servidor.
INDIGENOUS_BACKEND_URL=
INDIGENOUS_BACKEND_TOKEN=
# NLLB: habilitar únicamente para la demo/investigación NO comercial autorizada.
INDIGENOUS_TRANSLATION_RESEARCH_ONLY=false
